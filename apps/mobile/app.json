{
  "expo": {
    "name": "PokerGym",
    "slug": "szkola-pokera",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "szkolapokera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "pl.lkarwowski.szkolapokera",
      "appleTeamId": "8NQ9GHY8GF",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false, "CFBundleAllowMixedLocalizations": true },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      }
    },
    "android": {
      "package": "pl.lkarwowski.szkolapokera",
      "adaptiveIcon": {
        "backgroundColor": "#0A1430",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-localization", { "supportedLocales": { "ios": ["pl", "en", "ja", "zh-Hant", "pt-BR", "fr"], "android": ["pl", "en", "ja", "zh-Hant", "pt-BR", "fr"] }, "supportsRTL": false }],
      [
        "expo-splash-screen",
        { "backgroundColor": "#0A1430", "image": "./assets/images/splash-icon.png", "imageWidth": 180 }
      ],
      ["expo-notifications", { "enableRemoteNotifications": false }],
      "expo-iap"
    ],
    "locales": {
      "pl": "./locales/systemowe/pl.json",
      "en": "./locales/systemowe/en.json",
      "ja": "./locales/systemowe/ja.json",
      "zh-Hant": "./locales/systemowe/zh-Hant.json",
      "pt-BR": "./locales/systemowe/pt-BR.json",
      "fr": "./locales/systemowe/fr.json"
    },
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
