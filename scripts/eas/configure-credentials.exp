#!/usr/bin/expect -f
# Jednorazowe założenie podpisu dla instalacji „ad hoc” (certyfikat dystrybucyjny + profil). Skrypt przeniesiony z repozytorium
# Treningu (lkarwowski494/trening), gdzie działa od 3.10.2026.
# `eas build --non-interactive` nie umie utworzyć certyfikatu, a `eas credentials:configure-build` jest tylko interaktywne —
# tu odpowiada za użytkownika: wszystkie zarejestrowane urządzenia („a”), a na pozostałe pytania — odpowiedź domyślna.
# Klucz ASC i zespół Apple przychodzą ze zmiennych środowiskowych (tryb klucza API, bez logowania Apple ID).
# Uruchamiany z katalogu apps/mobile (tam są app.json i eas.json).
set timeout 300
log_user 1
spawn npx --yes eas-cli@$env(EAS_CLI) credentials:configure-build -p ios -e adhoc
expect {
  -re {Select devices for the ad hoc build} { sleep 1; send "a"; sleep 1; send "\r"; exp_continue }
  -re {register them now\?} { puts "\n::error::Brak zarejestrowanych urządzeń na koncie Expo — zobacz README: rejestracja iPhone'a."; exit 2 }
  -re {Select certificates to revoke} { puts "\n::error::Limit certyfikatów Apple — usuń stary certyfikat w developer.apple.com."; exit 3 }
  -re {›[^\n]*\(Y/n\)} { sleep 1; send "\r"; exp_continue }
  -re {›[^\n]*\(y/N\)} { sleep 1; send "\r"; exp_continue }
  -re {› - Use arrow-keys} { sleep 1; send "\r"; exp_continue }
  timeout { puts "\n::error::Brak odpowiedzi przez 300 s — nieznane pytanie eas-cli (patrz log wyżej)."; exit 4 }
  eof
}
catch wait result
exit [lindex $result 3]
