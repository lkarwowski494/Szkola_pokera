{
  "name": "szkola-pokera",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "tresci:rejestr": "node docs/tresci/narzedzia/scal-rejestr.mjs --przeglad zastępczy --sprawdz",
    "content:build": "pnpm --filter @szkola/content-build build",
    "content:check": "pnpm --filter @szkola/content-build check",
    "test:skrypty": "node --test scripts/sprawdz-i18n.test.mjs docs/tresci/narzedzia/scal-rejestr.test.mjs tests/narzedzia/sprawdz-eksport.test.mjs tests/narzedzia/k07-zakazy.test.mjs tests/narzedzia/k08-manifesty.test.mjs",
    "i18n": "node scripts/sprawdz-i18n.mjs apps/mobile/src/i18n/locales --zrodlo pl",
    "i18n:kod": "node scripts/sprawdz-i18n.mjs apps/mobile/src/i18n/locales --zrodlo pl --kod apps/mobile/src",
    "ci": "pnpm typecheck && pnpm test && pnpm test:skrypty && pnpm i18n && pnpm content:check && pnpm tresci:rejestr",
    "test:akceptacja": "tsc -p tests/akceptacja && vitest run --root tests/akceptacja"
  }
}
