{
  "name": "szkola-pokera",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "content:build": "pnpm --filter @szkola/content-build build",
    "content:check": "pnpm --filter @szkola/content-build check",
    "ci": "pnpm typecheck && pnpm test && pnpm content:check"
  }
}
